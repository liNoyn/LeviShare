<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LeviShare.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#3FB27F</Color>
    <Color x:Key="SystemAccentColorDark1">#2F9468</Color>
    <Color x:Key="SystemAccentColorLight1">#5CCB98</Color>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#2B2D31" />
      <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo, sans-serif" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="#F0A050" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="#7FD8A8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="#FF7B6B" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#313338" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3FB27F" />
      <Setter Property="Foreground" Value="#10261C" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="22,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5CCB98" />
      <Setter Property="Foreground" Value="#10261C" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#5CCB98" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9BE5C1" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="26" />
    </Style>
  </Application.Styles>
</Application>
