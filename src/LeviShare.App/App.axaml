<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LeviShare.App.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <!-- Semantic colors follow LeviLauncher's default emerald / zinc palette.
         See DESIGN.md for the reference files. No React or CSS source is bundled. -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Canvas">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Inset">#F4F4F5</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#EAEAEC</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#27272A</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#52525B</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#E4E4E7</SolidColorBrush>
          <SolidColorBrush x:Key="Brand">#047857</SolidColorBrush>
          <SolidColorBrush x:Key="BrandSoft">#ECFDF5</SolidColorBrush>
          <SolidColorBrush x:Key="BrandLine">#6EE7B7</SolidColorBrush>
          <SolidColorBrush x:Key="Primary">#047857</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryHover">#065F46</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackground">#FFFBEB</SolidColorBrush>
          <SolidColorBrush x:Key="WarningInk">#92400E</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessInk">#047857</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorInk">#B91C1C</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackground">#F4F4F5</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderContentBackground">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Canvas">#09090B</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#18181B</SolidColorBrush>
          <SolidColorBrush x:Key="Inset">#27272A</SolidColorBrush>
          <SolidColorBrush x:Key="Hover">#3F3F46</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#A1A1AA</SolidColorBrush>
          <SolidColorBrush x:Key="Line">#303036</SolidColorBrush>
          <SolidColorBrush x:Key="Brand">#34D399</SolidColorBrush>
          <SolidColorBrush x:Key="BrandSoft">#102B24</SolidColorBrush>
          <SolidColorBrush x:Key="BrandLine">#24634F</SolidColorBrush>
          <SolidColorBrush x:Key="Primary">#047857</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryHover">#059669</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackground">#30271A</SolidColorBrush>
          <SolidColorBrush x:Key="WarningInk">#FCD34D</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessInk">#6EE7B7</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorInk">#FCA5A5</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderHeaderBackground">#27272A</SolidColorBrush>
          <SolidColorBrush x:Key="ExpanderContentBackground">#18181B</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#047857" RegionColor="#FAFAFA" />
        <ColorPaletteResources x:Key="Dark" Accent="#34D399" RegionColor="#09090B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Canvas}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo, sans-serif" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource WarningInk}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="SelectableTextBlock.message"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="SelectableTextBlock.message.success"><Setter Property="Foreground" Value="{DynamicResource SuccessInk}" /></Style>
    <Style Selector="SelectableTextBlock.message.error"><Setter Property="Foreground" Value="{DynamicResource ErrorInk}" /></Style>
    <Style Selector="SelectableTextBlock.message.warning"><Setter Property="Foreground" Value="{DynamicResource WarningInk}" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="18" /></Style>
    <Style Selector="Border.warning"><Setter Property="Background" Value="{DynamicResource WarningBackground}" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="TextBlock.detail"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /><Setter Property="MaxWidth" Value="280" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Border.item"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style Selector="Border.item.selected"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource BrandLine}" /></Style>
    <Style Selector="Border.item:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Brand}" /></Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource Inset}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="20" /><Setter Property="Padding" Value="16,9" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Hover}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Primary}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="18,13" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryHover}" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
    <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="Button.ghost.active"><Setter Property="Background" Value="{DynamicResource Inset}" /><Setter Property="Foreground" Value="{DynamicResource Brand}" /></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Brand}" /><Setter Property="Padding" Value="8,4" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="12,10" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="12,9" /><Setter Property="Background" Value="{DynamicResource Inset}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style Selector="CheckBox.shareRow"><Setter Property="MinHeight" Value="34" /><Setter Property="Margin" Value="12,2" /><Setter Property="Padding" Value="8,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="CheckBox.shareRow /template/ Grid#RootGrid > Grid"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="ToggleButton.filter"><Setter Property="CornerRadius" Value="18" /><Setter Property="Padding" Value="12,8" /><Setter Property="Background" Value="{DynamicResource Inset}" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ToggleButton.filter:checked"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /><Setter Property="Foreground" Value="{DynamicResource Brand}" /></Style>
    <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrandSoft}" /><Setter Property="Foreground" Value="{DynamicResource Brand}" /></Style>
  </Application.Styles>
</Application>
